---
// Request-access dialog. Opened by any element with `data-open-request-access`, any link to
// `#request-access`, or that hash in the URL (see src/scripts/site.ts). The form posts JSON to
// /api/request-access (server route).
import Logo from '~/components/Logo.astro';
---

<dialog id="request-access-modal" class="modal" aria-labelledby="request-access-title">
  <div class="relative p-6 sm:p-8">
    <button
      type="button"
      data-close-request-access
      class="absolute right-3 top-3 grid h-11 w-11 place-items-center rounded-lg text-on-light-2 transition-colors hover:bg-teal-dark/10 hover:text-on-light"
      aria-label="Close"
    >
      <svg
        viewBox="0 0 24 24"
        width="20"
        height="20"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M6 18 18 6M6 6l12 12"></path>
      </svg>
    </button>

    <Logo variant="mark" class="mb-4 h-9" decorative />
    <h2 id="request-access-title" class="mb-2 font-heading text-2xl font-bold tracking-tight text-on-light">
      Request access
    </h2>
    <p class="mb-6 text-sm leading-relaxed text-on-light-2">
      UnderlandEX is invitation-only while we onboard institutional users. Tell us about you and we&rsquo;ll be in touch
      within one business day.
    </p>

    <form id="request-access-form" class="space-y-4" novalidate data-astro-reload>
      <div>
        <label for="ra-name" class="field-label">Full name</label>
        <input id="ra-name" name="name" type="text" autocomplete="name" required class="field" />
      </div>
      <div>
        <label for="ra-email" class="field-label">Work email</label>
        <input id="ra-email" name="email" type="email" autocomplete="email" required class="field" />
      </div>
      <div>
        <label for="ra-company" class="field-label">Company</label>
        <input id="ra-company" name="company" type="text" autocomplete="organization" required class="field" />
      </div>
      <div>
        <label for="ra-role" class="field-label">Role</label>
        <select id="ra-role" name="role" required class="field">
          <option value="">Select…</option>
          <option>Institutional investor</option>
          <option>Exploration company</option>
          <option>Commodity trader</option>
          <option>Royalty holder</option>
          <option>Family office</option>
          <option>Government / regulator</option>
          <option>Other</option>
        </select>
      </div>
      <div>
        <label for="ra-source" class="field-label">Interested product</label>
        <select id="ra-source" name="product" class="field">
          <option>UnderlandEX Explorer</option>
          <option>UnderlandEX M&amp;A</option>
          <option>All of the above</option>
        </select>
      </div>

      <button type="submit" class="btn-gold !mt-6 w-full">Request access</button>
      <p
        id="ra-status"
        role="status"
        aria-live="polite"
        class="min-h-5 text-center text-sm text-on-light-2 data-[kind=error]:text-red-700 data-[kind=ok]:text-teal-deep"
      >
      </p>
    </form>
  </div>
</dialog>
