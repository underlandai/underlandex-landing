---
// Grid of short capability or audience statements, each with an icon.
import { Icon } from 'astro-icon/components';

export interface Item {
  title: string;
  description: string;
  icon?: string;
}

export interface Props {
  items: Item[];
  tone?: 'dark' | 'light';
  columns?: 2 | 3;
  numbered?: boolean;
  class?: string;
}

const { items, tone = 'light', columns = 3, numbered = false, class: className = '' } = Astro.props;
const dark = tone === 'dark';
---

<ul class:list={['grid gap-x-10 gap-y-0 sm:grid-cols-2', columns === 3 && 'lg:grid-cols-3', className]}>
  {
    items.map((item, i) => (
      <li class:list={['flex gap-5 border-t py-7 lg:py-9', dark ? 'border-line-dark' : 'border-teal-dark/30']}>
        <span
          class:list={[
            'grid h-12 w-12 flex-none place-items-center rounded-xl',
            dark ? 'bg-ink-700 text-gold-bright ring-1 ring-inset ring-line-dark' : 'bg-teal-dark text-sand-100',
          ]}
          aria-hidden="true"
        >
          <Icon name={item.icon || 'tabler:arrow-right'} class="h-6 w-6" />
        </span>
        <div>
          {numbered && (
            <span
              class:list={[
                'mb-1 block font-heading text-[0.6875rem] font-bold tracking-label',
                dark ? 'text-on-dark-2' : 'text-on-light-2',
              ]}
              aria-hidden="true"
            >
              {String(i + 1).padStart(2, '0')}
            </span>
          )}
          <h3 class:list={['text-xl leading-snug', dark ? 'text-on-dark' : 'text-on-light']}>{item.title}</h3>
          <p class:list={['mt-2 leading-relaxed', dark ? 'text-on-dark-2' : 'text-on-light-2']}>
            {item.description}
          </p>
        </div>
      </li>
    ))
  }
</ul>
