---
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import { getHomePermalink } from '~/utils/permalinks';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface Links {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  links: Array<Links>;
  secondaryLinks: Array<Link>;
  socialLinks: Array<Link>;
  footNote?: string;
}

const { socialLinks = [], secondaryLinks = [], links = [], footNote = '' } = Astro.props;
---

<footer class="surface-deep border-t border-line-dark">
  <div class="strata-rule opacity-80" aria-hidden="true"></div>
  <div class="wrap grid gap-10 py-14 md:grid-cols-12 md:py-16">
    <div class="md:col-span-5">
      <a class="inline-block py-2 pr-3" href={getHomePermalink()} aria-label="UnderlandEX home">
        <Logo class="h-12" decorative />
      </a>
      {
        secondaryLinks.length > 0 && (
          <p class="mt-4 flex flex-wrap gap-x-3 gap-y-1 text-sm text-on-dark-2">
            {secondaryLinks.map(({ text, href }) => (
              <a class="underline-offset-4 hover:text-on-dark hover:underline" href={href} set:html={text} />
            ))}
          </p>
        )
      }
    </div>
    {
      links.map(({ title, links }) => (
        <nav class="md:col-span-2" aria-label={title}>
          <h2 class="mb-4 font-heading text-xs font-bold uppercase tracking-label text-gold-bright">{title}</h2>
          <ul class="space-y-2.5 text-[0.9375rem]">
            {links.map(({ text, href, ariaLabel }) => (
              <li>
                <a
                  class="text-on-dark-2 no-underline underline-offset-4 transition-colors hover:text-on-dark hover:underline"
                  href={href}
                  aria-label={ariaLabel}
                >
                  <Fragment set:html={text} />
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
  <div class="border-t border-line-dark">
    <div class="wrap flex flex-col gap-4 py-6 text-sm text-on-dark-2 sm:flex-row sm:items-center sm:justify-between">
      <p><Fragment set:html={footNote} /></p>
      {
        socialLinks.length > 0 && (
          <ul class="-ml-2 flex sm:ml-0">
            {socialLinks.map(({ ariaLabel, href, text, icon }) => (
              <li>
                <a
                  class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-on-dark-2 transition-colors hover:bg-sand/10 hover:text-on-dark"
                  aria-label={ariaLabel}
                  href={href}
                >
                  {icon && <Icon name={icon} class="h-6 w-6" />}
                  <Fragment set:html={text} />
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</footer>
