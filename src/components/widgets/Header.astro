---
import Logo from '~/components/Logo.astro';
import { getHomePermalink } from '~/utils/permalinks';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
}

interface ActionLink extends Link {
  variant?: string;
  openRequestAccess?: boolean;
}

export interface Props {
  id?: string;
  links?: Array<Link>;
  actions?: Array<ActionLink>;
  isSticky?: boolean;
}

const { id = 'header', links = [], actions = [], isSticky = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href = '') => !href.includes('#') && href !== '/' && (path === href || path.startsWith(`${href}/`));
---

<header
  id={id}
  class:list={[
    isSticky ? 'sticky' : 'relative',
    'top-0 z-50 border-b border-line-dark bg-ink-900 text-on-dark lg:bg-[rgba(8,19,17,0.86)] lg:backdrop-blur-lg lg:backdrop-saturate-150',
  ]}
>
  <div class="wrap flex min-h-16 items-center justify-between gap-6 lg:min-h-[4.5rem]">
    <!-- clear space: nothing sits closer to the lock-up than the height of its "u" -->
    <a class="block flex-none py-2 pr-3" href={getHomePermalink()} aria-label="UnderlandEX home">
      <Logo class="h-10 lg:h-11" decorative />
    </a>
    <button
      type="button"
      class="grid h-11 w-11 place-items-center rounded-lg border border-line-dark text-on-dark lg:hidden"
      aria-expanded="false"
      aria-controls="site-nav"
      data-nav-toggle
    >
      <span class="sr-only">Toggle menu</span>
      <svg
        viewBox="0 0 24 24"
        width="24"
        height="24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>
    <nav
      id="site-nav"
      aria-label="Main navigation"
      data-open="false"
      class="absolute inset-x-0 top-full hidden flex-col gap-4 border-b border-line-dark bg-ink-900 px-4 pb-6 pt-3 data-[open=true]:flex sm:px-6 lg:static lg:flex lg:flex-row lg:items-center lg:gap-8 lg:border-0 lg:bg-transparent lg:p-0"
    >
      <ul class="flex flex-col lg:flex-row lg:gap-1">
        {
          links.map(({ text, href, ariaLabel }) => (
            <li>
              <a
                class="block border-b border-line-dark px-1 py-3 font-heading text-[1.0625rem] font-semibold text-on-dark no-underline transition-colors hover:text-gold-bright aria-[current=page]:text-gold-bright lg:rounded-md lg:border-0 lg:px-3 lg:py-2 lg:text-[0.9375rem]"
                href={href}
                aria-label={ariaLabel}
                aria-current={isCurrent(href) ? 'page' : undefined}
              >
                {text}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="flex gap-2.5">
        {
          actions.map(({ variant, text, href, openRequestAccess }) => {
            const cls = `${variant === 'primary' ? 'btn-gold' : 'btn-ghost'} btn-sm flex-1 lg:flex-none`;
            return openRequestAccess ? (
              <button type="button" data-open-request-access class={cls}>
                {text}
              </button>
            ) : (
              <a href={href} class={cls}>
                {text}
              </a>
            );
          })
        }
      </div>
    </nav>
  </div>
</header>
