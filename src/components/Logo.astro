---
// UnderlandEX logo. `variant="full"` is the lock-up (mark, wordmark, tagline);
// `variant="mark"` is the symbol alone. Clear space is part of the component:
// padding equal to the height of the wordmark's "u" keeps neighbours off the logo.
import { MARK_VIEWBOX, LOGO_VIEWBOX } from '~/utils/brand';

export interface Props {
  variant?: 'full' | 'mark';
  class?: string;
  decorative?: boolean;
}

const { variant = 'full', class: className = 'h-11', decorative = false } = Astro.props;
const isFull = variant === 'full';
---

<svg
  viewBox={isFull ? LOGO_VIEWBOX : MARK_VIEWBOX}
  class:list={['block w-auto flex-none', className]}
  style={`aspect-ratio:${isFull ? '250.135 / 48.36' : '94.394 / 94.875'}`}
  role={decorative ? undefined : 'img'}
  aria-label={decorative ? undefined : 'UnderlandEX'}
  aria-hidden={decorative ? 'true' : undefined}
  focusable="false"
>
  <use href={isFull ? '#uex-logo' : '#uex-mark'}></use>
</svg>
