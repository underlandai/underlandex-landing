---
// Live wire: the three most recent deals from UnderlandEX M&A.
type Deal = {
  id: number;
  exchange: string;
  ticker: string;
  company_name: string;
  title: string;
  published_at: string;
  source_url: string;
  dealType?: string | null;
  sector?: string | null;
  country?: string | null;
};

let deals: Deal[] = [];
try {
  const res = await fetch('https://mna.underlandex.com/api/deals?limit=3', {
    signal: AbortSignal.timeout(6000),
  });
  if (res.ok) {
    const data = (await res.json()) as { deals?: Deal[] };
    deals = (data.deals || []).slice(0, 3);
  }
} catch {
  // silently fall through to empty array
}

const relativeTime = (iso: string) => {
  const d = new Date(iso);
  const diffMs = Date.now() - d.getTime();
  const hours = Math.floor(diffMs / (1000 * 60 * 60));
  if (hours < 1) return 'just now';
  if (hours < 24) return `${hours}h ago`;
  const days = Math.floor(hours / 24);
  if (days < 7) return `${days}d ago`;
  return d.toLocaleDateString('en-AU', { day: 'numeric', month: 'short' });
};

const titleCase = (s: string) =>
  s
    .toLowerCase()
    .split(/\s+/)
    .map((w) => (w.length > 2 ? w[0].toUpperCase() + w.slice(1) : w))
    .join(' ');
---

<section id="wire" class="rounded-2xl bg-sand-50 p-6 shadow-card ring-1 ring-teal-dark/10 sm:p-9 lg:p-12" aria-labelledby="wire-title">
  <div class="mb-8 grid items-end gap-x-16 gap-y-4 lg:mb-10 lg:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)]">
    <div>
      <p class="eyebrow eyebrow-plain">
        <span class="live-dot bg-teal" aria-hidden="true"></span>
        Live from the wire
      </p>
      <h3 id="wire-title" class="h-sub text-on-light">
        The latest mining deals,<br class="hidden sm:inline" />
        ingested as they hit the exchange.
      </h3>
    </div>
    <p class="text-[0.9375rem] text-on-light-2">
      Pulled directly from UnderlandEX M&amp;A. Sign in to see the complete feed, filter by commodity and build custom
      watchlists.
    </p>
  </div>

  {
    deals.length === 0 ? (
      <p class="rounded-xl border border-dashed border-teal-dark/30 py-12 text-center text-sm text-on-light-2">
        Live feed unavailable. It refreshes on the next build.
      </p>
    ) : (
      <ul class="grid gap-4 md:grid-cols-3">
        {deals.map((d) => (
          <li>
            <article class="flex h-full flex-col rounded-xl border border-teal-dark/20 bg-white p-5">
              <div class="mb-4 flex items-center justify-between gap-3">
                <div class="flex items-center gap-2">
                  <span class="rounded bg-ink-800 px-2 py-0.5 font-heading text-xs font-bold uppercase tracking-[0.12em] text-sand-100 sm:text-[0.625rem]">
                    {d.exchange}
                  </span>
                  <span class="font-mono text-xs text-on-light-2 sm:text-[0.6875rem]">{d.ticker}</span>
                </div>
                <span class="text-xs text-on-light-2 sm:text-[0.6875rem]">{relativeTime(d.published_at)}</span>
              </div>
              <p class="mb-1.5 truncate font-heading text-xs font-bold uppercase tracking-[0.08em] text-teal-deep">
                {titleCase(d.company_name)}
              </p>
              <h4 class="line-clamp-3 min-h-[3.9em] text-[0.9375rem] font-semibold leading-snug text-on-light">
                {d.title}
              </h4>
              <div class="mt-auto flex flex-wrap items-center gap-2 border-t border-teal-dark/15 pt-3 text-xs text-on-light-2 sm:text-[0.6875rem]">
                {d.dealType && (
                  <span class="rounded bg-gold/25 px-1.5 py-0.5 font-heading font-bold text-on-light">{d.dealType}</span>
                )}
                {d.sector && <span>{d.sector}</span>}
                {d.country && <span>· {d.country}</span>}
              </div>
            </article>
          </li>
        ))}
      </ul>
    )
  }

  <div class="mt-8">
    <button type="button" data-open-request-access class="btn-teal">
      See the full feed <span aria-hidden="true">→</span>
    </button>
  </div>
</section>
