---
// Latest insights posts.
import { getBlogPermalink, getPermalink } from '~/utils/permalinks';
import { findLatestPosts } from '~/utils/blog';
import { getFormattedDate } from '~/utils/utils';

export interface Props {
  id?: string;
  title: string;
  information?: string;
  linkText?: string;
  count?: number;
}

const { id = 'insights', title, information, linkText = 'View all posts', count = 4 } = Astro.props;
const posts = await findLatestPosts({ count });
---

<section id={id} class="section surface-paper" aria-labelledby={`${id}-title`}>
  <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-14">
    <header class="lg:col-span-4">
      <p class="eyebrow">Briefings</p>
      <h2 id={`${id}-title`} class="h-section text-on-light">{title}</h2>
      {information && <p class="lead mt-5 text-on-light-2">{information}</p>}
      <a class="link-rule mt-7 text-teal-deep" href={getBlogPermalink()}>
        {linkText} <span aria-hidden="true">»</span>
      </a>
    </header>
    <ul class="grid gap-5 lg:col-span-8">
      {
        posts.map((post) => (
          <li>
            <a
              href={getPermalink(post.permalink, 'post')}
              class="group block overflow-hidden rounded-2xl bg-white no-underline shadow-card ring-1 ring-teal-dark/10 transition hover:-translate-y-0.5 hover:ring-teal-dark/40"
            >
              <div class="strata-rule" aria-hidden="true" />
              <article class="p-6 sm:p-8">
                <p class="mb-3 font-heading text-xs font-bold uppercase tracking-[0.12em] text-on-light-2">
                  <time datetime={String(post.publishDate)}>{getFormattedDate(post.publishDate)}</time>
                  {post.category && <span> · {post.category.title}</span>}
                </p>
                <h3 class="h-sub text-on-light group-hover:text-teal-deep">{post.title}</h3>
                {post.excerpt && <p class="mt-3 max-w-2xl text-on-light-2">{post.excerpt}</p>}
                <span class="link-rule mt-5 text-teal-deep" aria-hidden="true">
                  Read the post <span>→</span>
                </span>
              </article>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
