---
import { Icon } from 'astro-icon/components';

import Image from '~/components/common/Image.astro';
import PostTags from '~/components/blog/Tags.astro';
import SocialShare from '~/components/common/SocialShare.astro';
import StrataDivider from '~/components/StrataDivider.astro';

import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';

import type { Post } from '~/types';

export interface Props {
  post: Post;
  url: string | URL;
}

const { post, url } = Astro.props;
---

<article>
  <header
    class="relative overflow-hidden bg-[linear-gradient(180deg,#07110f_0%,#0b1917_55%,#0d1e1b_100%)] pb-28 pt-12 text-on-dark sm:pb-36 sm:pt-16 lg:pt-20"
  >
    <div class="relative mx-auto max-w-3xl px-4 sm:px-6">
      <p class="mb-5 flex flex-wrap items-center gap-x-2 gap-y-1 font-heading text-xs font-bold uppercase tracking-[0.12em] text-on-dark-2">
        <Icon name="tabler:clock" class="-mt-0.5 inline-block h-4 w-4 text-gold-bright" aria-hidden="true" />
        <time datetime={String(post.publishDate)}>{getFormattedDate(post.publishDate)}</time>
        {
          post.author && (
            <>
              <span aria-hidden="true">·</span>
              <span>{post.author}</span>
            </>
          )
        }
        {
          post.category && (
            <>
              <span aria-hidden="true">·</span>
              <a class="text-gold-bright underline-offset-4 hover:underline" href={getPermalink(post.category.slug, 'category')}>
                {post.category.title}
              </a>
            </>
          )
        }
        {
          post.readingTime && (
            <>
              <span aria-hidden="true">·</span>
              <span>{post.readingTime} min read</span>
            </>
          )
        }
      </p>
      <h1 class="display-sm text-on-dark">{post.title}</h1>
      <p class="lead mt-6 text-on-dark-2">{post.excerpt}</p>
    </div>
    <StrataDivider to="#f7f8f6" />
  </header>

  <div class="surface-paper pb-6 pt-8 sm:pt-12">
    {
      post.image && (
        <div class="mx-auto mb-10 max-w-3xl px-4 sm:px-6">
          <Image
            src={post.image}
            class="mx-auto rounded-xl"
            widths={[400, 900]}
            sizes="(max-width: 900px) 400px, 900px"
            alt={post?.excerpt || ''}
            width={900}
            height={506}
            loading="eager"
            decoding="async"
          />
        </div>
      )
    }
    <div class="prose-strata mx-auto max-w-3xl px-4 sm:px-6 lg:prose-lg">
      <slot />
    </div>
    <div class="mx-auto mt-12 flex max-w-3xl flex-col justify-between gap-5 border-t border-teal-dark/20 px-4 pt-6 sm:flex-row sm:px-6">
      <PostTags tags={post.tags} class="text-sm" />
      <SocialShare url={url} text={post.title} class="align-middle text-on-light-2" />
    </div>
  </div>
</article>
