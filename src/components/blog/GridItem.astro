---
import { APP_BLOG } from 'astrowind:config';
import type { Post } from '~/types';

import Image from '~/components/common/Image.astro';

import { findImage } from '~/utils/images';
import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';

export interface Props {
  post: Post;
}

const { post } = Astro.props;
const image = await findImage(post.image);

const link = APP_BLOG?.post?.isEnabled ? getPermalink(post.permalink, 'post') : '';
---

<article
  class="group relative flex h-full flex-col overflow-hidden rounded-2xl bg-white shadow-card ring-1 ring-teal-dark/10 transition hover:-translate-y-0.5 hover:ring-teal-dark/40"
>
  <div class="strata-rule" aria-hidden="true"></div>
  {
    image && (
      <Image
        src={image}
        class="aspect-video w-full object-cover"
        widths={[400, 900]}
        width={400}
        sizes="(max-width: 900px) 400px, 900px"
        alt={post.title}
        aspectRatio="16:9"
        layout="cover"
        loading="lazy"
        decoding="async"
      />
    )
  }
  <div class="flex flex-1 flex-col p-6 sm:p-8">
    <p class="mb-3 font-heading text-xs font-bold uppercase tracking-[0.12em] text-on-light-2">
      <time datetime={String(post.publishDate)}>{getFormattedDate(post.publishDate)}</time>
      {post.category && <span> · {post.category.title}</span>}
    </p>
    <h2 class="h-sub text-on-light">
      {
        link ? (
          <a class="no-underline after:absolute after:inset-0 group-hover:text-teal-deep" href={link}>
            {post.title}
          </a>
        ) : (
          post.title
        )
      }
    </h2>
    <p class="mt-3 text-on-light-2">{post.excerpt}</p>
  </div>
</article>
