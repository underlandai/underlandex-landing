---
// Layered wave that carries a dark section into the next surface, like bedding planes.
export interface Props {
  to?: string; // colour of the surface that follows
  class?: string;
}

const { to = '#ece6d8', class: className = '' } = Astro.props;
---

<svg
  class:list={['pointer-events-none absolute inset-x-0 -bottom-px block h-16 w-full sm:h-24 lg:h-28', className]}
  viewBox="0 0 1440 120"
  preserveAspectRatio="none"
  aria-hidden="true"
  focusable="false"
>
  <path fill="#1d3a35" d="M0 44c180-26 320 20 520 8s330-52 540-34 260 40 380 30v72H0z"></path>
  <path fill="#4a6963" d="M0 66c200-22 360 22 560 10s300-44 500-28 270 30 380 22v50H0z"></path>
  <path fill="#89b09f" d="M0 84c220-16 380 18 580 8s300-34 480-22 280 24 380 16v34H0z"></path>
  <path fill="#b09763" d="M0 97c230-10 400 12 600 5s300-22 470-14 280 14 370 10v22H0z"></path>
  <path fill={to} d="M0 104c240-7 410 9 610 4s300-15 460-10 280 10 370 7v15H0z"></path>
</svg>
