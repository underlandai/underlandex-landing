---
// Product screenshot in a window frame with the sign-in gate, beside its description.
// The images are refreshed nightly (scripts/capture-previews.mjs).
import Image from '~/components/common/Image.astro';

export interface Props {
  title: string;
  caption: string;
  image: ImageMetadata;
  badge?: string;
  note?: string;
  address?: string;
  reverse?: boolean;
  tone?: 'dark' | 'light';
  moreHref?: string;
  moreText?: string;
  headingLevel?: 'h2' | 'h3';
}

const {
  title,
  caption,
  image,
  badge,
  note,
  address,
  reverse = false,
  tone = 'dark',
  moreHref,
  moreText,
  headingLevel: Heading = 'h3',
} = Astro.props;
const dark = tone === 'dark';
---

<div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-14">
  <div class:list={['lg:col-span-5', reverse && 'lg:order-2']}>
    {badge && <p class:list={['eyebrow', dark && 'eyebrow-gold']}>{badge}</p>}
    <Heading class:list={['h-sub', dark ? 'text-on-dark' : 'text-on-light']}>{title}</Heading>
    <p class:list={['lead mt-5', dark ? 'text-on-dark' : 'text-on-light']}>{caption}</p>
    {note && <p class:list={['mt-4 text-[0.9375rem]', dark ? 'text-on-dark-2' : 'text-on-light-2']}>{note}</p>}
    <slot />
    <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
      <button type="button" data-open-request-access class={dark ? 'btn-gold' : 'btn-teal'}>Request access</button>
      {
        moreHref && (
          <a href={moreHref} class:list={['link-rule', dark ? 'text-gold-bright' : 'text-teal-deep']}>
            {moreText} <span aria-hidden="true">→</span>
          </a>
        )
      }
    </div>
  </div>

  <figure class:list={['relative lg:col-span-7', reverse && 'lg:order-1']}>
    <div class="overflow-hidden rounded-xl bg-ink-800 shadow-frame">
      <div class="flex h-9 items-center gap-1.5 border-b border-line-dark bg-ink-700 px-3.5" aria-hidden="true">
        <span class="h-2.5 w-2.5 rounded-full bg-sand/25"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-sand/25"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-sand/25"></span>
        {
          address && (
            <span class="ml-3 truncate rounded bg-ink-900/70 px-2.5 py-0.5 font-mono text-xs text-on-dark-2 sm:text-[0.6875rem]">
              {address}
            </span>
          )
        }
      </div>
      <div class="relative">
        <Image
          src={image}
          alt={title}
          class="block h-auto w-full"
          widths={[480, 800, 1200, 1600]}
          sizes="(max-width: 1023px) 100vw, 720px"
        />
        <!-- sign-in gate: the lower part of the screen is veiled -->
        <div
          class="absolute inset-x-0 bottom-0 h-3/5 bg-gradient-to-b from-transparent to-ink-950/90 backdrop-blur-[2px] [mask-image:linear-gradient(180deg,transparent,#000_55%)]"
          aria-hidden="true"
        >
        </div>
        <figcaption class="absolute inset-x-0 bottom-4 flex justify-center px-4 sm:bottom-7">
          <div class="flex items-center gap-3 rounded-lg bg-sand-50 px-4 py-2.5 shadow-lg ring-1 ring-black/5 sm:px-5 sm:py-3">
            <svg
              class="h-5 w-5 flex-none text-teal-deep"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
              ></path>
            </svg>
            <div>
              <div class="font-heading text-sm font-bold text-on-light">Sign in to preview</div>
              <div class="text-xs text-on-light-2">Invitation-only while we onboard users</div>
            </div>
          </div>
        </figcaption>
      </div>
    </div>
  </figure>
</div>
