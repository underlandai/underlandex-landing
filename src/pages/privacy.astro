---
import Layout from '~/layouts/PageLayout.astro';
import PageHero from '~/components/PageHero.astro';

const metadata = { title: 'Privacy Policy' };
---

<Layout metadata={metadata}>
  <PageHero tagline="Legal" subtitle="Last updated: April 2026" dividerTo="#f7f8f6" compact seed={6}>
    <Fragment slot="title">Privacy Policy</Fragment>
  </PageHero>

  <section class="surface-paper pb-20 pt-8 sm:pb-24 sm:pt-12 lg:pb-32">
    <div class="prose-strata mx-auto max-w-3xl px-4 sm:px-6 lg:prose-lg">
      <p>
        UnderlandEX is operated by Morum Pty Ltd (ACN pending), a company incorporated in Australia. We are committed to
        protecting your personal information in accordance with the <em>Privacy Act 1988</em> (Cth) and the Australian Privacy
        Principles.
      </p>

      <h2>Information we collect</h2>
      <p>
        We collect information you provide directly — name, work email, company and role — when you request access or
        contact us. We also collect standard server logs (IP address, browser type, pages visited) and, where enabled,
        analytics events via PostHog.
      </p>

      <h2>How we use it</h2>
      <p>
        We use your information to evaluate access requests, communicate with you about your account, and improve the
        platform. We do not sell personal information to third parties.
      </p>

      <h2>Third-party services</h2>
      <p>
        We use Resend for transactional email, Auth0 for authentication, and Airtable for CRM. Each service operates
        under its own privacy policy. Data is stored in Australia or the United States.
      </p>

      <h2>Your rights</h2>
      <p>
        You may request access to, correction of, or deletion of your personal information at any time by emailing <a
          href="mailto:oliver@underlandex.com">oliver@underlandex.com</a
        >.
      </p>

      <h2>Contact</h2>
      <p>For privacy enquiries: <a href="mailto:oliver@underlandex.com">oliver@underlandex.com</a></p>
    </div>
  </section>
</Layout>
