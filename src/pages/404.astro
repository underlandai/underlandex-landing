---
import Layout from '~/layouts/PageLayout.astro';
import TopoLines from '~/components/TopoLines.astro';
import { getHomePermalink } from '~/utils/permalinks';

const title = `Error 404`;
---

<Layout metadata={{ title }}>
  <section class="surface-dark relative overflow-hidden py-24 sm:py-32 lg:py-40">
    <TopoLines class="inset-0 h-full w-full text-sage opacity-[0.14]" seed={9} rings={15} />
    <div class="wrap relative text-center">
      <h1 class="font-heading font-bold leading-none tracking-tight text-gold [font-size:clamp(6rem,22vw,13rem)]">
        <span class="sr-only">Error</span>
        404
      </h1>
      <p class="h-sub mt-4 text-on-dark">Sorry, we couldn't find this page.</p>
      <p class="lead mx-auto mt-4 max-w-xl text-on-dark-2">
        But don't worry, you can find plenty of other things on our homepage.
      </p>
      <a href={getHomePermalink()} class="btn-gold mt-9">Back to homepage</a>
    </div>
  </section>
</Layout>
