---
import Layout from '~/layouts/PageLayout.astro';
import PageHero from '~/components/PageHero.astro';
import Grid from '~/components/blog/Grid.astro';

import { blogListRobots, fetchPosts } from '~/utils/blog';

export const prerender = true;

const posts = await fetchPosts();

const metadata = {
  title: `Insights — UnderlandEX`,
  robots: {
    index: blogListRobots?.index,
    follow: blogListRobots?.follow,
  },
  openGraph: {
    type: 'blog',
  },
};
---

<Layout metadata={metadata}>
  <PageHero
    tagline="The UnderlandEX Insights"
    subtitle="New data drops, deal commentary and research from the UnderlandEX team."
    dividerTo="#f7f8f6"
    compact
    seed={3}
  >
    <Fragment slot="title">Weekly market intelligence</Fragment>
  </PageHero>

  <section class="surface-paper pb-20 pt-8 sm:pb-24 sm:pt-12 lg:pb-32" aria-label="Posts">
    <div class="wrap">
      <Grid posts={posts} />
    </div>
  </section>
</Layout>
