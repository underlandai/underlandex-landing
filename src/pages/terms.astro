---
import Layout from '~/layouts/PageLayout.astro';
import PageHero from '~/components/PageHero.astro';

const metadata = { title: 'Terms of Service' };
---

<Layout metadata={metadata}>
  <PageHero tagline="Legal" subtitle="Last updated: April 2026" dividerTo="#f7f8f6" compact seed={6}>
    <Fragment slot="title">Terms of Service</Fragment>
  </PageHero>

  <section class="surface-paper pb-20 pt-8 sm:pb-24 sm:pt-12 lg:pb-32">
    <div class="prose-strata mx-auto max-w-3xl px-4 sm:px-6 lg:prose-lg">
      <p>
        These Terms of Service govern your access to and use of the UnderlandEX platform, operated by UnderlandEX (Morum
        Pty Ltd) ("we", "us"). By accessing the platform you agree to these terms.
      </p>

      <h2>Access</h2>
      <p>
        Access to UnderlandEX is by invitation only. We may revoke access at our discretion. You must not share your
        credentials or permit unauthorised access to the platform.
      </p>

      <h2>Permitted use</h2>
      <p>
        The platform and its data are provided for internal research and evaluation purposes only. You must not
        redistribute, resell, scrape, or reproduce platform data without our written consent.
      </p>

      <h2>No financial advice</h2>
      <p>
        Information on UnderlandEX is for informational purposes only and does not constitute financial, investment,
        legal or tax advice. Always seek independent professional advice before making investment decisions.
      </p>

      <h2>Accuracy</h2>
      <p>
        We endeavour to keep data accurate and current but make no warranty as to completeness, accuracy or fitness for
        purpose. Data is sourced from public exchange disclosures and regulatory registries.
      </p>

      <h2>Limitation of liability</h2>
      <p>
        To the maximum extent permitted by law, UnderlandEX (Morum Pty Ltd) is not liable for any loss or damage arising
        from your use of or reliance on the platform.
      </p>

      <h2>Governing law</h2>
      <p>
        These terms are governed by the laws of Western Australia, Australia. Any disputes will be subject to the
        exclusive jurisdiction of the courts of Western Australia.
      </p>

      <h2>Contact</h2>
      <p>Questions: <a href="mailto:oliver@underlandex.com">oliver@underlandex.com</a></p>
    </div>
  </section>
</Layout>
